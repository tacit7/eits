#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

if [[ -z "${EITS_EXTRAS:-}" ]]; then
  if [[ -x "$script_dir/eits-extras" ]]; then
    export EITS_EXTRAS="$script_dir/eits-extras"
  elif [[ -x "$repo_root/priv/libexec/eits-extras" ]]; then
    export EITS_EXTRAS="$repo_root/priv/libexec/eits-extras"
  fi
fi

for candidate in \
  "$repo_root/target/release/eits" \
  "$repo_root/target/debug/eits" \
  "$repo_root/target/release/eitsr" \
  "$repo_root/target/debug/eitsr"; do
  if [[ -x "$candidate" ]]; then
    exec "$candidate" "$@"
  fi
done

cat >&2 <<EOF
error: Rust eits CLI binary not found.

Build it with:
  cargo build -p eits-cli --bin eits

Legacy extras script is preserved at:
  $script_dir/eits-extras
EOF
exit 127
